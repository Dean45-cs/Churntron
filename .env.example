# Datenbank. Passt so, wenn du "npm run db:up" (Docker) benutzt.
# Bei einer Cloud-Datenbank stattdessen deren Connection String eintragen.
DATABASE_URL="postgresql://churntron:churntron@localhost:5432/churntron"

# NextAuth signiert damit die Sitzungen.
# Fuer eine oeffentliche Umgebung einen eigenen Wert erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="hier-ein-eigenes-secret-eintragen"

# Passwort der beiden Demo-Konten (siehe README).
DEMO_PASSWORD="churntron"

# Auf 1 setzen, um die Skeletons sichtbar zu machen: verzoegert die Abfragen
# kuenstlich und blendet oben den Hinweis "Demo · erfundene Daten" ein.
# In einer produktiven Umgebung mit echten Daten leer lassen.
SKELETON_DEMO="0"
